# WalletConnect/Reown project id. Needed for Keplr Mobile deep-link flow.
VITE_WALLETCONNECT_PROJECT_ID=

# Terra Classic Launchpad. Legacy VITE_LAUNCHPAD_* names remain supported.
VITE_LUNC_LAUNCHPAD_CREATION_FEE=30000
VITE_LUNC_LAUNCHPAD_LP_LOCKER_ADDRESS=
VITE_LUNC_LAUNCHPAD_REGISTRY_ADDRESS=

# Terra Phoenix Launchpad. Deploy the Burrito locker and registry before
# enabling public LP locking and public listings.
VITE_LUNA_LAUNCHPAD_CREATION_FEE=1
VITE_LUNA_LAUNCHPAD_LP_LOCKER_ADDRESS=terra1zs54uanqzwh2y4a6z9xlzawjyjp3tddd99ad0h58ghr5yh2fdfjq95gmcv
VITE_LUNA_LAUNCHPAD_REGISTRY_ADDRESS=terra1wlfv0q9hye0x0tpd8844c0cmnaz7893x50h2z9q7897d6mjw0w3st4xj5f

# Per-chain emergency switches. Leave empty for enabled; set to 1 to disable.
VITE_DISABLE_LUNC_SWAP=
VITE_DISABLE_LUNC_MARKET=
VITE_DISABLE_LUNC_LAUNCHPAD=
VITE_DISABLE_LUNA_SWAP=
VITE_DISABLE_LUNA_MARKET=
VITE_DISABLE_LUNA_LAUNCHPAD=

# Optional sanitized transaction telemetry endpoint.
VITE_TX_DIAGNOSTICS_ENDPOINT=
