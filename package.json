{
  "name": "burrito-web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:release": "npm run build:market-all && npm run build",
    "build:market-index": "node scripts/build-market-index.mjs",
    "build:market-candles": "node scripts/build-market-candles.mjs",
    "build:market-all": "npm run build:market-index && npm run build:market-candles",
    "lint": "eslint .",
    "test": "vitest run --exclude tests/e2e/**",
    "test:e2e": "playwright test",
    "check:audit": "node scripts/check-dependency-audit.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "verify": "npm run lint && npm test && npm run check:audit && npm run build && npm run check:bundle",
    "preview": "vite preview",
    "deploy:launchpad": "node scripts/deploy-launchpad-contracts.mjs"
  },
  "dependencies": {
    "@cosmjs/amino": "^0.36.2",
    "@cosmjs/cosmwasm-stargate": "^0.36.2",
    "@cosmjs/encoding": "^0.36.2",
    "@cosmjs/proto-signing": "^0.36.2",
    "@cosmjs/stargate": "^0.36.2",
    "@cosmos-kit/core": "^2.18.1",
    "@cosmos-kit/keplr-mobile": "^2.17.1",
    "@cosmos-kit/react": "^2.24.1",
    "@cosmos-kit/walletconnect": "^2.15.1",
    "@interchain-ui/react": "^1.26.3",
    "@tanstack/react-query": "^5.90.20",
    "@terra-money/log-finder-ruleset": "^3.0.3",
    "axios": "^1.16.1",
    "cosmjs-types": "^0.10.1",
    "json5": "^2.2.3",
    "lightweight-charts": "^5.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "terser": "^5.47.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "form-data": "4.0.6",
    "protobufjs": "7.6.4",
    "ws": "7.5.11",
    "uuid": "11.1.1"
  }
}
