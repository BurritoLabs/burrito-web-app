{
  "name": "burrito-web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:release": "npm run build:market-all && npm run build",
    "build:market-index": "node scripts/build-market-index.mjs",
    "build:market-candles": "node scripts/build-market-candles.mjs",
    "build:market-all": "npm run build:market-index && npm run build:market-candles",
    "build:brand-assets": "node scripts/build-brand-assets.mjs",
    "build:social-preview": "node scripts/build-social-preview.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "check:audit": "node scripts/check-dependency-audit.mjs",
    "check:market-assets": "node scripts/check-market-asset-identities.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:wallet-specs": "node scripts/verify-wallet-specs.mjs",
    "verify": "npm run lint && npm test && npm run check:wallet-specs && npm run check:audit && npm run check:market-assets && npm run build && npm run check:bundle",
    "preview": "vite preview",
    "deploy:launchpad": "node scripts/deploy-launchpad-contracts.mjs",
    "upgrade:launchpad": "node scripts/upgrade-launchpad-contracts.mjs"
  },
  "dependencies": {
    "@burritolabs/ui": "github:BurritoLabs/burrito-design-system#e09b4f6",
    "@cosmjs/amino": "^0.36.2",
    "@cosmjs/cosmwasm-stargate": "^0.36.2",
    "@cosmjs/encoding": "^0.36.2",
    "@cosmjs/proto-signing": "^0.36.2",
    "@cosmjs/stargate": "^0.36.2",
    "@cosmos-kit/core": "^2.18.1",
    "@cosmos-kit/keplr-mobile": "^2.17.1",
    "@cosmos-kit/react-lite": "^2.18.1",
    "@tanstack/react-query": "^5.101.2",
    "@terra-money/log-finder-ruleset": "^3.0.3",
    "axios": "^1.18.1",
    "cosmjs-types": "^0.10.1",
    "json5": "^2.2.3",
    "lightweight-charts": "^5.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "terser": "^5.47.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.3.6",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "form-data": "4.0.6",
    "protobufjs": "7.6.5",
    "ws": "7.5.11",
    "uuid": "11.1.1"
  }
}
