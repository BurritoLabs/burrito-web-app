{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://burritolabs.ca/specs/wallet/transaction-intent.v1.schema.json",
  "title": "Burrito Transaction Intent v1",
  "description": "A serializable, user-reviewable transaction request. It is never an authorization for a backend to sign.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "chainId", "account", "messages", "memo", "origin"],
  "properties": {
    "version": { "const": 1 },
    "chainId": { "enum": ["columbus-5", "phoenix-1"] },
    "account": { "type": "string", "pattern": "^terra1[0-9a-z]+$" },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["typeUrl", "value"],
        "properties": {
          "typeUrl": { "type": "string", "pattern": "^/[A-Za-z0-9._/]+$" },
          "value": { "type": "object" }
        }
      }
    },
    "fee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "gas"],
      "properties": {
        "amount": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["denom", "amount"],
            "properties": {
              "denom": { "type": "string", "minLength": 1 },
              "amount": { "type": "string", "pattern": "^[0-9]+$" }
            }
          }
        },
        "gas": { "type": "string", "pattern": "^[0-9]+$" }
      }
    },
    "memo": { "type": "string" },
    "origin": { "type": "string", "minLength": 1 }
  }
}
